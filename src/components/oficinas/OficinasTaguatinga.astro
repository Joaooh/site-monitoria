---
import { Image } from "astro:assets";
import imgMagosTrabalhando from "@assets/mago/oficinas/magos-trabalhando.png";
import { oficinasAtivasTaguatingaData } from "@data/oficinas-ativas-taguatinga.js";
import { oficinasPassadasTaguatingaData } from "@data/oficinas-passadas-taguatinga.js";

const placeholders = [1, 2, 3];
---

<section class="taguatinga-section ativas" id="taguatinga-ativas">
  <div class="container">
    <div class="section-header">
      <h2>Oficinas Disponíveis <br /> Campus Taguatinga</h2>
      <div class="divider"></div>
    </div>

    <div class="cards-grid">
      {
        oficinasAtivasTaguatingaData.length > 0
          ? oficinasAtivasTaguatingaData.map((oficina) => (
              <article class="card">
                <div class="card-image-wrapper">
                  <Image
                    src={oficina.imagem}
                    alt={oficina.alt}
                    class="card-image"
                    quality={70}
                    format="webp"
                  />
                  <div class="badges-overlay">
                    <span
                      class={`badge-formato ${oficina.formato.toLowerCase()}`}
                    >
                      {oficina.formato}
                    </span>
                  </div>
                </div>

                <div class="card-content">
                  <h3>{oficina.titulo}</h3>
                  <p class="descricao">{oficina.descricao}</p>

                  <div class="info-horario">
                    {oficina.turmas.map((turma: string) => (
                      <div class="info-item">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect
                            x="3"
                            y="4"
                            width="18"
                            height="18"
                            rx="2"
                            ry="2"
                          />
                          <line x1="16" y1="2" x2="16" y2="6" />
                          <line x1="8" y1="2" x2="8" y2="6" />
                          <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span>{turma}</span>
                      </div>
                    ))}
                  </div>

                  <a href={oficina.linkInscricao} class="btn-inscrever">
                    Clique para saber mais
                  </a>
                </div>
              </article>
            ))
          : placeholders.map(() => (
              <article class="card-placeholder">
                <div class="card-image-wrapper">
                  <Image
                    src={imgMagosTrabalhando}
                    alt="Magos trabalhando nas futuras oficinas de Taguatinga"
                    class="card-image"
                    quality={70}
                    format="webp"
                  />
                </div>
                <div class="card-content">
                  <button class="btn-em-breve-fantasma" disabled>
                    Em breve
                  </button>
                </div>
              </article>
            ))
      }
    </div>
  </div>
</section>

<section class="taguatinga-section passadas" id="taguatinga-passadas">
  <div class="container">
    <div class="section-header">
      <h2>Oficinas Passadas <br /> Campus Taguatinga</h2>
      <div class="divider"></div>
    </div>

    <div class="carousel-wrapper">
      <button class="carousel-btn prev" aria-label="Oficinas anteriores">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
      </button>

      <div class="carousel-track" id="taguatinga-passadas-track">
        {
          oficinasPassadasTaguatingaData.length > 0
            ? oficinasPassadasTaguatingaData.map((oficina) => (
                <article class="card-passada">
                  <div class="card-image-wrapper">
                    <Image
                      src={oficina.imagem}
                      alt={oficina.alt}
                      class="card-image"
                      quality={70}
                      format="webp"
                    />
                  </div>

                  <div class="card-content">
                    <h3>{oficina.titulo}</h3>
                    <p class="descricao">{oficina.descricao}</p>

                    <a href={oficina.linkInscricao} class="btn-inscrever">
                      Clique para saber mais
                    </a>
                  </div>
                </article>
              ))
            : placeholders.map(() => (
                <article class="card-passada card-placeholder">
                  <div class="card-image-wrapper">
                    <Image
                      src={imgMagosTrabalhando}
                      alt="Magos trabalhando nas futuras oficinas de Taguatinga"
                      class="card-image"
                      quality={70}
                      format="webp"
                    />
                  </div>
                  <div class="card-content">
                    <button class="btn-em-breve-fantasma" disabled>
                      Em breve
                    </button>
                  </div>
                </article>
              ))
        }
      </div>

      <div class="carousel-indicator" id="taguatinga-passadas-indicator"></div>

      <button class="carousel-btn next" aria-label="Próximas oficinas">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </button>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const track = document.getElementById("taguatinga-passadas-track");
    const indicator = document.getElementById("taguatinga-passadas-indicator");
    const carouselWrapper = track?.closest(".carousel-wrapper");
    if (!carouselWrapper) return;
    const btnPrev = carouselWrapper.querySelector(".carousel-btn.prev");
    const btnNext = carouselWrapper.querySelector(".carousel-btn.next");
    const cards = Array.from(carouselWrapper.querySelectorAll(".card-passada"));

    if (!track || !btnPrev || !btnNext || cards.length === 0) return;

    let currentPage = 0;
    let itemsPerPage = 3;

    const renderPage = () => {
      if (window.innerWidth >= 1024) {
        itemsPerPage = 3;
      } else if (window.innerWidth >= 768) {
        itemsPerPage = 2;
      } else {
        itemsPerPage = 1;
      }

      const totalPages = Math.ceil(cards.length / itemsPerPage);

      if (currentPage >= totalPages) currentPage = totalPages - 1;
      if (currentPage < 0) currentPage = 0;

      btnPrev.style.opacity = currentPage === 0 ? "0.3" : "1";
      btnPrev.style.pointerEvents = currentPage === 0 ? "none" : "all";

      btnNext.style.opacity = currentPage >= totalPages - 1 ? "0.3" : "1";
      btnNext.style.pointerEvents =
        currentPage >= totalPages - 1 ? "none" : "all";

      if (indicator) {
        indicator.textContent = `${currentPage + 1}/${totalPages}`;
      }

      cards.forEach((card) => {
        card.classList.remove("active");
        card.style.display = "none";
      });

      const startIndex = currentPage * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const currentCards = cards.slice(startIndex, endIndex);

      currentCards.forEach((card, index) => {
        card.style.display = "flex";
        void card.offsetWidth;
        card.style.animationDelay = `${index * 0.08}s`;
        card.classList.add("active");
      });
    };

    btnPrev.addEventListener("click", () => {
      if (currentPage > 0) {
        currentPage--;
        renderPage();
      }
    });

    btnNext.addEventListener("click", () => {
      const totalPages = Math.ceil(cards.length / itemsPerPage);
      if (currentPage < totalPages - 1) {
        currentPage++;
        renderPage();
      }
    });

    let resizeTimer;
    const handleResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(renderPage, 200);
    };

    window.addEventListener("resize", handleResize);

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("resize", handleResize);
      },
      { once: true },
    );

    renderPage();
  });
</script>

<style>
  .taguatinga-section {
    padding: 80px 2rem;
    position: relative;
    z-index: 10;
  }

  .taguatinga-section.ativas {
    background-color: #ffffff;
  }

  .taguatinga-section.passadas {
    background-color: #fafafa;
    padding-bottom: 100px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    color: var(--text-dark);
    margin-bottom: 1rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .divider {
    width: 60px;
    height: 3px;
    background-color: var(--purple-primary);
    border-radius: 2px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    justify-content: center;
  }

  /* ESTILOS CARD ATIVO */
  .card {
    background: #ddd1ff;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 25px rgba(59, 0, 77, 0.15);
  }

  .card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
    background: var(--bg-light);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card:hover .card-image {
    transform: scale(1.05);
  }

  .badges-overlay {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .badge-formato {
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .badge-formato.presencial {
    background: #8b33cf;
    color: #ffffff;
  }

  .badge-formato.online {
    background: #2e7d32;
    color: #ffffff;
  }

  .card-content {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-content h3 {
    color: #3b004d;
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .descricao {
    color: var(--text-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .info-horario {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(59, 0, 77, 0.1);
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #555555;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .info-item svg {
    color: var(--purple-hero);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .btn-inscrever {
    display: block;
    width: 100%;
    padding: 12px 0;
    background: var(--purple-primary);
    border: none;
    color: #ffffff;
    text-align: center;
    border-radius: 8px;
    font-weight: 600;
    text-transform: none;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
    box-shadow: 0 4px 10px rgba(102, 44, 146, 0.2);
  }

  .btn-inscrever:hover {
    background: var(--purple-hero);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(122, 26, 143, 0.3);
  }

  /* ESTILOS CARD PLACEHOLDER (EM BREVE) */
  .card-placeholder {
    background: #ddd1ff;
    border: none;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .card-placeholder .card-image-wrapper {
    aspect-ratio: 4 / 3;
    background: #a9d6ff;
  }

  .card-placeholder .card-content {
    padding: 1.2rem;
    display: flex;
    justify-content: center;
  }

  .btn-em-breve-fantasma {
    display: block;
    width: 100%;
    padding: 10px 0;
    background: transparent;
    border: 1px solid var(--purple-primary);
    color: var(--purple-primary);
    text-align: center;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: not-allowed;
    transition: all 0.3s ease;
  }

  /* ESTILOS CARROUSSEL DE PASSADAS */
  .carousel-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-track {
    display: flex;
    gap: 24px;
    justify-content: center;
    width: 100%;
    min-height: 440px;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: var(--purple-primary);
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(102, 44, 146, 0.3);
    color: var(--text-main);
    transition: all 0.3s ease;
  }

  .carousel-btn:hover {
    background: #4a148c;
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 6px 15px rgba(74, 20, 140, 0.4);
    color: var(--text-main);
  }

  .carousel-btn svg {
    width: 24px;
    height: 24px;
  }

  .carousel-btn.prev {
    left: -60px;
  }

  .carousel-btn.next {
    right: -60px;
  }

  .card-passada {
    flex: 0 0 340px;
    display: none;
    opacity: 0;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    overflow: hidden;
    flex-direction: column;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }

  .card-passada.active {
    display: flex;
    animation: fadeInPage 0.4s ease-out forwards;
  }

  @keyframes fadeInPage {
    0% {
      opacity: 0;
      transform: scale(0.96) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .card-passada.active:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .card-passada.card-placeholder {
    background: #ddd1ff;
  }

  .card-passada .btn-inscrever {
    background: transparent;
    border: 1px solid var(--purple-primary);
    color: var(--purple-primary);
    box-shadow: none;
    margin-top: auto;
  }

  .card-passada .btn-inscrever:hover {
    background: var(--purple-primary);
    color: #ffffff;
    box-shadow: none;
    transform: translateY(-2px);
  }

  .carousel-indicator {
    display: none;
  }

  /* --- RESPONSIVIDADE MOBILE --- */
  @media (max-width: 600px) {
    .taguatinga-section {
      padding: 60px 1.5rem;
    }

    .taguatinga-section.passadas {
      padding-bottom: 80px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
    }

    .card-placeholder:nth-child(n + 2) {
      display: none;
    }

    .card-passada {
      flex: 0 0 100%;
      max-width: 340px;
    }

    .carousel-wrapper {
      padding-bottom: 60px;
    }

    .carousel-btn {
      top: auto;
      bottom: 0;
      transform: none;
    }

    .carousel-btn:hover {
      transform: scale(1.05);
    }

    .carousel-btn.prev {
      left: calc(50% - 90px);
    }

    .carousel-btn.next {
      right: calc(50% - 90px);
    }

    .carousel-indicator {
      display: block;
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      font-weight: 700;
      color: var(--text-dark);
      font-size: 0.95rem;
      z-index: 5;
      letter-spacing: 2px;
    }
  }
</style>
