---
import { Image } from "astro:assets";
import BeneficioIcon from "./BeneficioIcon.astro";
import {
  assinaturasEstudante,
  categoriasBeneficios,
} from "@data/beneficios.js";

const contagem = (id: string) =>
  id === "todos"
    ? assinaturasEstudante.length
    : assinaturasEstudante.filter((a) => a.categoria === id).length;

const labelCategoria = (id: string) =>
  categoriasBeneficios.find((c) => c.id === id)?.label ?? id;
---

<section
  class="assinaturas-section"
  id="assinaturas"
  aria-labelledby="assinaturas-title"
>
  <div class="container">
    <div class="section-header">
      <span class="tag">Parceiros</span>
      <h2 id="assinaturas-title" aria-label="Assinaturas e descontos">
        Assinaturas e descontos
      </h2>
      <p class="section-subtitle">
        Ferramentas profissionais, streaming e eletrônicos com condições
        especiais para quem tem vínculo estudantil.
      </p>
    </div>

    <div
      class="filtros"
      role="group"
      aria-label="Filtrar benefícios por categoria"
    >
      {
        categoriasBeneficios.map((cat, i) => (
          <button
            type="button"
            class="filtro"
            data-filtro={cat.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {cat.label}
            <span class="filtro-count">{contagem(cat.id)}</span>
          </button>
        ))
      }
    </div>

    <p class="sr-only" aria-live="polite" data-filtro-status></p>

    <ul class="assinaturas-grid">
      {
        assinaturasEstudante.map((item) => (
          <li class="assinatura-item" data-categoria={item.categoria}>
            <article
              class="assinatura-card"
              style={`--brand: ${item.cor};`}
              data-expandable-card
            >
              <span class="brand-watermark" aria-hidden="true">
                <BeneficioIcon
                  name={item.icone}
                  size={52}
                  uid={`watermark-${item.id}`}
                />
              </span>

              <div
                class="card-summary"
                data-expand-trigger
                role="button"
                tabindex="0"
                aria-expanded="false"
                aria-label={`${item.nome} (${item.empresa}): ${item.destaque}`}
              >
                <div class="card-top">
                  <span class="brand-tile" aria-hidden="true">
                    {item.imagem ? (
                      <Image
                        src={item.imagem}
                        alt={item.empresa}
                        class="brand-logo"
                        width={64}
                        height={64}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <BeneficioIcon
                        name={item.icone}
                        size={28}
                        uid={`tile-${item.id}`}
                      />
                    )}
                  </span>
                  <span class="categoria-pill">
                    {labelCategoria(item.categoria)}
                  </span>
                </div>

                <div class="card-main">
                  <span class="empresa">{item.empresa}</span>
                  <h3 aria-label={item.nome}>{item.nome}</h3>
                  <span class="tipo">{item.tipo}</span>
                  <p class="mobile-destaque">{item.destaque}</p>
                </div>

                <div class="expand-indicator" aria-hidden="true">
                  <span class="indicator-text">
                    <span class="more-text">Saiba mais</span>
                    <span class="less-text">Recolher</span>
                  </span>
                  <svg
                    class="chevron-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </div>
              </div>

              <div class="card-details">
                <div class="card-details-inner">
                  <span class="destaque">{item.destaque}</span>

                  <div class="mobile-meta-row">
                    <span class="mobile-categoria-pill">
                      {labelCategoria(item.categoria)}
                    </span>
                    <span class="mobile-tipo">{item.tipo}</span>
                  </div>

                  <p class="descricao">{item.descricao}</p>

                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card-footer"
                    aria-label={`${item.nome} (${item.empresa}): ${item.destaque} (abre em nova aba)`}
                  >
                    Acessar benefício
                    <BeneficioIcon name="arrow" size={16} />
                    <span class="sr-only">(abre em nova aba)</span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  function initFiltrosBeneficios() {
    const section = document.querySelector<HTMLElement>("#assinaturas");
    if (!section || section.dataset.filtrosBound === "true") return;
    section.dataset.filtrosBound = "true";

    const filtrosContainer = section.querySelector<HTMLElement>(".filtros");
    const botoes = section.querySelectorAll<HTMLButtonElement>(".filtro");
    const itens = section.querySelectorAll<HTMLElement>(".assinatura-item");
    const status = section.querySelector<HTMLElement>("[data-filtro-status]");

    filtrosContainer?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const botao = target?.closest<HTMLButtonElement>(".filtro");
      if (!botao || botao.getAttribute("aria-pressed") === "true") return;

      const filtro = botao.dataset.filtro;
      let visiveis = 0;

      botoes.forEach((b) =>
        b.setAttribute("aria-pressed", String(b === botao)),
      );

      const paraAnimar: HTMLElement[] = [];
      itens.forEach((item) => {
        const mostrar =
          filtro === "todos" || item.dataset.categoria === filtro;
        item.classList.remove("is-entering");
        item.hidden = !mostrar;
        if (mostrar) {
          visiveis++;
          paraAnimar.push(item);
        }
      });

      requestAnimationFrame(() => {
        paraAnimar.forEach((item) => item.classList.add("is-entering"));
      });

      if (status) {
        status.textContent = `${visiveis} benefício${visiveis === 1 ? "" : "s"} exibido${visiveis === 1 ? "" : "s"}.`;
      }
    });
  }

  document.addEventListener("astro:page-load", initFiltrosBeneficios);
</script>

<style>
  .assinaturas-section {
    background: linear-gradient(to bottom, var(--bg-dark), #160824);
    padding: 100px 2rem 110px 2rem;
    position: relative;
    overflow: hidden;
    overflow: clip;
    scroll-margin-top: 40px;
    content-visibility: auto;
    contain-intrinsic-size: auto 900px;
  }

  .assinaturas-section::before {
    content: "";
    position: absolute;
    top: -200px;
    right: -150px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(134, 64, 190, 0.28),
      transparent 70%
    );
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tag {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(210, 168, 255, 0.1);
    color: var(--purple-neon);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    border: 1px solid rgba(210, 168, 255, 0.2);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-main);
    margin-bottom: 0.75rem;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 600px;
  }

  /* --- Filtros --- */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filtro {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(210, 168, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .filtro:hover {
      color: var(--text-main);
      border-color: rgba(210, 168, 255, 0.45);
      background: rgba(210, 168, 255, 0.08);
    }
  }

  .filtro[aria-pressed="true"] {
    background: var(--purple-neon);
    border-color: var(--purple-neon);
    color: #1a1a1a;
    font-weight: 600;
  }

  .filtro-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
  }

  .filtro[aria-pressed="true"] .filtro-count {
    background: rgba(26, 26, 26, 0.15);
  }

  /* --- Grid --- */
  .assinaturas-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .assinatura-item[hidden] {
    display: none;
  }

  .assinatura-item.is-entering {
    animation: cardIn 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .assinatura-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    border-radius: 16px;
    background: rgba(102, 44, 146, 0.16);
    border: 1px solid rgba(210, 168, 255, 0.12);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    overflow: clip;
    contain: layout paint;
    isolation: isolate;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .assinatura-card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--purple-neon));
    opacity: 0.85;
  }

  .assinatura-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 220px;
    height: 220px;
    background: radial-gradient(
      circle at 0% 0%,
      var(--brand) 0%,
      transparent 70%
    );
    opacity: 0;
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .assinatura-card:hover {
      transform: translateY(-6px);
      border-color: rgba(210, 168, 255, 0.5);
      box-shadow:
        0 15px 30px rgba(0, 0, 0, 0.4),
        0 0 25px rgba(102, 44, 146, 0.3);
    }

    .assinatura-card:hover::after {
      opacity: 0.28;
    }

    .assinatura-card:hover .brand-tile {
      transform: scale(1.06) translateZ(0);
      border-color: color-mix(
        in srgb,
        var(--brand) 70%,
        rgba(210, 168, 255, 0.45)
      );
      box-shadow:
        0 8px 22px rgba(0, 0, 0, 0.5),
        0 0 22px color-mix(in srgb, var(--brand) 40%, transparent);
    }

    .assinatura-card:hover .card-footer :global(svg) {
      transform: translate(3px, -3px);
    }
  }

  .card-summary {
    outline: none;
  }

  .brand-watermark,
  .mobile-destaque,
  .mobile-meta-row,
  .expand-indicator {
    display: none;
  }

  .card-details,
  .card-details-inner {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .brand-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--brand) 22%, #10061e);
    border: 1px solid
      color-mix(in srgb, var(--brand) 45%, rgba(255, 255, 255, 0.15));
    color: #ffffff;
    box-shadow:
      0 6px 18px rgba(0, 0, 0, 0.4),
      0 0 16px color-mix(in srgb, var(--brand) 25%, transparent);
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
    will-change: transform;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .categoria-pill {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-muted);
  }

  .card-main {
    margin-bottom: 1rem;
  }

  .empresa {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--purple-neon);
    margin-bottom: 0.3rem;
  }

  .card-main h3 {
    color: var(--text-main);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.25rem 0;
  }

  .tipo {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .destaque {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(210, 168, 255, 0.14);
    border: 1px solid rgba(210, 168, 255, 0.28);
    color: #ebd4ff;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .descricao {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--purple-neon);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 641px) {
    .card-footer::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: 16px;
    }
  }

  .card-footer:focus-visible {
    outline: 3px solid var(--purple-neon);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .card-footer :global(svg) {
    transition: transform 0.3s ease;
  }

  /* --- RESPONSIVIDADE MOBILE --- */
  @media (max-width: 640px) {
    .assinaturas-section {
      padding: 70px 1.25rem 80px 1.25rem;
    }

    .filtros {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin: 0 -1.25rem 2rem -1.25rem;
      padding: 0 1.25rem 0.25rem 1.25rem;
      scrollbar-width: none;
    }

    .filtros::-webkit-scrollbar {
      display: none;
    }

    .filtro {
      flex-shrink: 0;
    }

    .assinaturas-grid {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }

    .assinatura-card {
      padding: 0;
      min-height: 120px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      background: rgba(42, 16, 68, 0.85);
    }

    .assinatura-card:hover {
      transform: none;
    }

    .assinatura-card::after {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to right,
        rgba(102, 44, 146, 0.55) 0%,
        rgba(102, 44, 146, 0) 50%
      );
      opacity: 1;
      z-index: 0;
    }

    .assinatura-card.is-expanded {
      border-color: rgba(210, 168, 255, 0.45);
      box-shadow:
        0 12px 28px rgba(0, 0, 0, 0.4),
        0 0 22px rgba(102, 44, 146, 0.28);
    }

    .brand-watermark {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 14px;
      right: 14px;
      width: 76px;
      height: 76px;
      color: #ffffff;
      opacity: 0.09;
      pointer-events: none;
      z-index: 0;
    }

    .card-summary {
      position: relative;
      z-index: 2;
      padding: 1.2rem 1.25rem 2.25rem 1.25rem;
      min-height: 120px;
      display: flex;
      align-items: center;
      gap: 0.95rem;
      cursor: pointer;
    }

    .card-summary:focus-visible {
      outline: 2px solid var(--purple-neon);
      outline-offset: -2px;
      border-radius: 16px;
    }

    .card-top {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .brand-tile {
      width: 48px;
      height: 48px;
      border-radius: 13px;
    }

    .categoria-pill,
    .tipo,
    .destaque {
      display: none;
    }

    .card-main {
      margin-bottom: 0;
      min-width: 0;
      flex: 1;
    }

    .empresa {
      font-size: 0.72rem;
      margin-bottom: 0.15rem;
    }

    .card-main h3 {
      font-size: 1.18rem;
      margin-bottom: 0.2rem;
    }

    .mobile-destaque {
      display: block;
      font-size: 0.86rem;
      font-weight: 600;
      color: #ebd4ff;
      line-height: 1.35;
      padding-right: 92px;
      margin: 0;
    }

    .expand-indicator {
      position: absolute;
      bottom: 1.05rem;
      right: 1.25rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #ebd4ff;
      font-size: 0.85rem;
      font-weight: 600;
      pointer-events: none;
    }

    .less-text {
      display: none;
    }

    .assinatura-card.is-expanded .more-text {
      display: none;
    }

    .assinatura-card.is-expanded .less-text {
      display: inline;
    }

    .chevron-icon {
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .assinatura-card.is-expanded .chevron-icon {
      transform: rotate(180deg);
    }

    .card-details {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.35s cubic-bezier(0.25, 0.8, 0.25, 1),
        opacity 0.25s ease;
    }

    .card-details-inner {
      overflow: hidden;
      padding: 0 1.25rem;
    }

    .assinatura-card.is-expanded .card-details {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .assinatura-card.is-expanded .card-details-inner {
      padding: 0 1.25rem 1.25rem 1.25rem;
    }

    .mobile-meta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      padding-top: 0.95rem;
      border-top: 1px solid rgba(210, 168, 255, 0.16);
      margin-bottom: 0.7rem;
    }

    .mobile-categoria-pill {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 4px 9px;
      border-radius: 6px;
      background: rgba(210, 168, 255, 0.14);
      color: #ebd4ff;
    }

    .mobile-tipo {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.65);
    }

    .descricao {
      font-size: 0.92rem;
      margin-bottom: 1.15rem;
    }

    .card-footer {
      width: 100%;
      justify-content: center;
      padding: 11px 16px;
      border-radius: 10px;
      border: 1px solid rgba(210, 168, 255, 0.35);
      background: rgba(210, 168, 255, 0.15);
      color: #ffffff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assinatura-item.is-entering {
      animation: none;
    }

    .assinatura-card,
    .assinatura-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
