const icon = icons[name] ?? icons.sparkles;

function createUniqueSvg(svgHtml: string, prefix?: string) {
  if (!svgHtml.includes("id=")) return svgHtml;
  const safePrefix =
    prefix ?? `${name}-${size}-${Math.random().toString(36).slice(2, 7)}`;
  return svgHtml
    .replace(/\bid="([^"]+)"/g, `id="${safePrefix}-$1"`)
    .replace(/url\(#([^)]+)\)/g, `url(#${safePrefix}-$1)`);
}

const uniqueHtml = createUniqueSvg(icon.html, uid);
