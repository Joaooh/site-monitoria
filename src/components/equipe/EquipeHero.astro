---
import { Image } from "astro:assets";
import FiberBackground from "@components/effects/Fiber.jsx";
import magoSpell from "@assets/mago/mago-spell.png";

interface Props {
  titulo: string;
  preTexto: string;
  subTexto: string;
}

const { titulo, preTexto, subTexto } = Astro.props;
---

<section class="equipe-hero">
  <div class="fiber-container mobile-gradient-bg">
    <FiberBackground client:media="(min-width: 768px)" />
    <div class="dark-overlay"></div>
  </div>

  <div class="container">
    <div class="hero-content">
      <div class="text-column">
        <h2 class="pre-title">{preTexto}</h2>
        <h1 class="title">{titulo}</h1>
        <p class="subtitle">{subTexto}</p>
      </div>

      <div class="image-column">
        <div class="image-wrapper-glow">
          <Image
            src={magoSpell}
            alt="Mago da monitoria conjurando um feitiço de luz"
            class="mago-spell-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .equipe-hero {
    position: relative;
    padding: 49px 2rem 0 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: var(--bg-dark);
    min-height: 35vh;
    border-bottom: 4px solid var(--purple-hero);
  }

  .fiber-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mobile-gradient-bg {
    background: var(--bg-dark);
  }

  .mobile-gradient-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--purple-primary);
    opacity: 0;
    transition: opacity 5s ease-in-out;
    animation: pulseGradient 8s ease-in-out infinite alternate;
  }

  @keyframes pulseGradient {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 0.8;
    }
  }

  .dark-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 4, 26, 0.4);
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 30px;
    gap: 1rem;
  }

  .text-column {
    flex: 0 0 50%;
    padding-bottom: 0px;
    z-index: 2;
  }

  .pre-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 400;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .title {
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: var(--text-main);
    letter-spacing: -2px;
    line-height: 1;
    margin-left: -4px;
  }

  .subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin: 0;
  }

  .image-column {
    flex: 0 0 50%;
    display: flex;
    justify-content: center;
    transform: translateX(-10%);
  }

  .image-wrapper-glow {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    margin-bottom: -167px;
  }

  .image-wrapper-glow::before {
    content: "";
    position: absolute;
    width: 80%;
    height: 80%;
    background: radial-gradient(
      circle,
      rgba(122, 26, 143, 0.4) 0%,
      rgba(13, 4, 26, 0) 70%
    );
    z-index: -1;
    border-radius: 50%;
    bottom: 100px;
  }

  .mago-spell-img {
    width: 100%;
    max-width: 510px;
    height: auto;
    object-fit: contain;
    transform: scaleX(-1);
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
  }

  /* --- RESPONSIVIDADE MOBILE --- */
  @media (max-width: 992px) {
    .equipe-hero {
      padding-top: 40px;
      padding-left: 0;
      padding-right: 0;
      min-height: auto;
    }

    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .hero-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .text-column {
      flex: 1;
      padding-bottom: 2px;
      padding-top: 0;
      align-items: center;
    }

    .title {
      margin-left: 0;
    }

    .image-column {
      flex: 1;
      justify-content: center;
      transform: translateX(0);
      width: 100vw;
    }

    .image-wrapper-glow {
      margin-bottom: -105px;
    }

    .mago-spell-img {
      width: 100%;
      max-width: 320px;
      height: auto;
      object-fit: contain;
      object-position: center bottom;
      margin-left: 0;
    }
  }
</style>
