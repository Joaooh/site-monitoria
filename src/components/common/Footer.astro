---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="brand-section">
        <Image
          src={logoCeub}
          alt="Logo do Centro Universitário de Brasília - CEUB"
          class="footer-logo"
        />
        <div class="brand-text">
          <h3 class="brand-title">Centro Universitário de Brasília – CEUB</h3>
          <p class="brand-subtitle">Monitoria dos Cursos de TI</p>
        </div>
      </div>

      <div class="contact-section">
        <h4 class="contact-title">Conecte-se conosco</h4>

        <a href="mailto:monitoriaticeub@gmail.com" class="email-link">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          monitoriaticeub@gmail.com
        </a>

        <div class="social-links">
          {
            socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-icon"
                aria-label={`Acessar ${link.name}`}
              >
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <Fragment set:html={link.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {currentYear} Monitoria de TI - CEUB/FATECS. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-darker);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 4rem 2rem 2rem 2rem;
    color: var(--text-muted);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .brand-section {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-logo {
    width: 80px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.15));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .brand-title {
    color: var(--text-main);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .brand-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-title {
    color: var(--text-main);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    margin-bottom: 0.5rem;
  }

  .email-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: var(--purple-neon);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .social-icon:hover {
    background-color: var(--purple-neon);
    color: var(--bg-dark);
    transform: translateY(-3px);
    box-shadow: 0 4px 12px rgba(210, 168, 255, 0.3);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 2rem;
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    margin: 0;
  }

  /* --- RESPONSIVIDADE MOBILE --- */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .brand-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .brand-title {
      font-size: 1.15rem;
    }

    .contact-section {
      align-items: center;
      text-align: center;
    }

    .social-links {
      justify-content: center;
    }
  }
</style>
