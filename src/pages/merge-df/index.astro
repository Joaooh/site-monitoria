---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/common/Footer.astro";
import FiberBackground from "../../components/effects/Fiber.jsx";
import MergeIcon from "../../components/merge-df/MergeIcon.astro";
import OrgAvatar from "../../components/merge-df/OrgAvatar.astro";
import {
  eventoMergeData as evento,
  organizacoesMergeData as organizacoes,
} from "../../data/merge-df.js";

const siteUrl =
  Astro.site?.toString() || "https://site-monitoria-blue.vercel.app/";
const pageUrl = new URL("/merge-df", siteUrl).href;

const normalizarTracos = (str = "") => str.replace(/\s+[—–-]\s+/g, " – ");

const eventoSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `${evento.nome}: ${evento.subtitulo}`,
  description: evento.premissa,
  startDate: evento.dataISO,
  endDate: evento.dataFimISO,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: {
    "@type": "Place",
    name: "Auditório do CEUB",
    address: "Centro Universitário de Brasília – CEUB, Brasília – DF",
  },
  organizer: {
    "@type": "Organization",
    name: "Monitoria de TI – CEUB",
    url: siteUrl,
  },
  url: pageUrl,
};
---

<Layout
  title="MERGE-DF | Monitoria de TI – CEUB"
  description="MERGE-DF: encontro de networking entre organizações estudantis de tecnologia das IES do DF. 13 de novembro, das 10h às 13h, no Auditório do CEUB. Conheça as organizações participantes."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(eventoSchema)}
    is:inline
  />

  <main id="main-content" class="merge-page">
    <!-- HERO -->
    <section class="merge-hero">
      <div class="fiber-container mobile-gradient-bg">
        <FiberBackground client:media="(min-width: 768px)" />
        <div class="dark-overlay" aria-hidden="true"></div>
      </div>

      <div class="hero-inner">
        <h1 class="hero-title">
          MERGE<span class="hero-title-accent">-DF</span>
        </h1>
        <p class="hero-subtitle">{evento.subtitulo}</p>
        <p class="hero-text">
          Menos palestra, mais conexão. Conheça quem estará no auditório e
          chegue sabendo com quem conversar.
        </p>
        <div class="hero-actions">
          <a href="#caderno" class="btn primary">
            Conhecer as organizações
            <MergeIcon name="arrow-down" size={18} />
          </a>
          <a href="#programacao" class="btn secondary">Ver programação</a>
        </div>
      </div>
    </section>

    <div class="light-section">
      <!-- FAIXA DE INFORMAÇÕES -->
      <div class="infos-wrapper">
        <ul class="infos" aria-label="Informações do evento">
          {
            evento.infos.map((info) => (
              <li class="info-item">
                <span class="info-icon">
                  <MergeIcon name={info.icone} size={22} />
                </span>
                <span class="info-text">
                  <span class="info-label">{info.label}</span>
                  <strong>{info.valor}</strong>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ORGANIZAÇÕES PARTICIPANTES -->
      <section id="caderno" class="section caderno" aria-labelledby="caderno-title">
        <div class="container">
          <div class="section-header">
            <span class="tag">Organizações Participantes</span>
            <h2 id="caderno-title">Quem estará no MERGE-DF</h2>
            <div class="divider"></div>
            <p class="section-lead">
              Toque em uma organização para ver o que ela faz, o que busca e
              sobre o que puxar papo no evento.
            </p>
          </div>

          <ul class="guild-grid">
            {
              organizacoes.map((org) => (
                <li class="guild-grid-item">
                  {org.temPagina !== false ? (
                    <a
                      href={`/merge-df/${org.slug}`}
                      class="guild-card"
                      style={`--org-cor: ${org.corDestaque ?? "#662c92"};`}
                    >
                      <div class="guild-banner" aria-hidden="true">
                        <span class="guild-banner-pattern" />
                      </div>
                      {org.demonstrativo && (
                        <span class="guild-exemplo">Exemplo</span>
                      )}

                      <div class="guild-emblem">
                        <OrgAvatar
                          nome={org.nome}
                          sigla={org.sigla}
                          logo={org.logo}
                          logoFit={org.logoFit}
                          cor={org.corDestaque}
                          fundo={org.corFundoLogo}
                          size={148}
                        />
                      </div>

                      <div class="guild-body">
                        <h3>{normalizarTracos(org.sigla)}</h3>
                        <p class="guild-nome">{normalizarTracos(org.nome)}</p>

                        <span class="guild-divider" aria-hidden="true">
                          <span />
                        </span>

                        <p class="guild-resumo">{org.resumoCurto}</p>

                        {org.puxePapo?.[0] && (
                          <div class="guild-papo">
                            <span class="guild-papo-label">
                              <MergeIcon name="chat" size={13} />
                              Puxe papo sobre
                            </span>
                            <span class="guild-papo-text">
                              {normalizarTracos(org.puxePapo[0])}
                            </span>
                          </div>
                        )}

                        <span class="guild-cta">
                          Conhecer organização
                          <MergeIcon name="arrow-right" size={16} />
                        </span>
                      </div>
                    </a>
                  ) : (
                    <div
                      class="guild-card guild-card--sem-pagina"
                      style={`--org-cor: ${org.corDestaque ?? "#16a34a"};`}
                    >
                      <div class="guild-banner" aria-hidden="true">
                        <span class="guild-banner-pattern" />
                      </div>

                      <div class="guild-emblem">
                        <OrgAvatar
                          nome={org.nome}
                          sigla={org.sigla}
                          logo={org.logo}
                          logoFit={org.logoFit}
                          cor={org.corDestaque}
                          fundo={org.corFundoLogo}
                          size={148}
                        />
                      </div>

                      <div class="guild-body">
                        <h3>{normalizarTracos(org.sigla)}</h3>
                        <p class="guild-nome">{normalizarTracos(org.nome)}</p>

                        <span class="guild-divider" aria-hidden="true">
                          <span />
                        </span>

                        {org.resumoCurto && (
                          <p class="guild-resumo">{org.resumoCurto}</p>
                        )}

                        <div class="guild-card-links">
                          {org.ondeEncontrar?.map((item) => (
                            <a
                              href={item.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="guild-card-link-btn"
                            >
                              <MergeIcon
                                name={
                                  item.tipo === "site"
                                    ? "globe"
                                    : item.tipo === "telegram"
                                      ? "send"
                                      : item.tipo === "instagram"
                                        ? "instagram"
                                        : item.tipo === "linkedin"
                                          ? "linkedin"
                                          : "link"
                                }
                                size={15}
                              />
                              <span>{item.label}</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- SOBRE + BENEFÍCIOS -->
      <section class="section sobre" aria-labelledby="sobre-title">
        <div class="container">
          <div class="section-header">
            <span class="tag">Sobre o evento</span>
            <h2 id="sobre-title">Networking ativo, parcerias reais</h2>
            <div class="divider"></div>
            <p class="section-lead">{evento.premissa}</p>
          </div>

          <ul class="beneficios">
            {
              evento.beneficios.map((b) => (
                <li class="beneficio">
                  <span class="beneficio-icon">
                    <MergeIcon name={b.icone} size={24} />
                  </span>
                  <h3>{b.titulo}</h3>
                  <p>{b.texto}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <!-- PROGRAMAÇÃO -->
    <section id="programacao" class="section programacao" aria-labelledby="programacao-title">
      <div class="container">
        <div class="section-header dark">
          <span class="tag tag-dark">Dinâmica do encontro</span>
          <h2 id="programacao-title">Programação pensada para conexões reais</h2>
          <div class="divider"></div>
        </div>

        <ol class="timeline">
          {
            evento.programacao.map((bloco) => (
              <li class="timeline-item">
                <div class="timeline-time">
                  <strong>{bloco.inicio}</strong>
                  <span>{bloco.duracao}</span>
                </div>
                <div class="timeline-dot" aria-hidden="true" />
                <div class="timeline-card">
                  <h3>{bloco.titulo}</h3>
                  <p>{bloco.descricao}</p>
                  <span class="timeline-range">
                    {bloco.inicio} – {bloco.fim}
                  </span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- CONVITE -->
    <div class="light-section">
      <section class="section convite" aria-labelledby="convite-title">
        <div class="container">
          <div class="convite-card">
            <div class="convite-text">
              <span class="tag">Unindo as Faculdades do DF</span>
              <h2 id="convite-title">Construindo pontes além do campus</h2>
              <p>{evento.convite}</p>
            </div>
            <img
              src="/mago-cabeca.png"
              alt=""
              class="convite-mago"
              width="200"
              height="210"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </div>
  </main>

  <div class="light-section">
    <Footer />
  </div>
</Layout>

<style>
  .merge-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--bg-dark);
  }

  .light-section {
    background-color: #fdfdfd;
    color: #1a1a24;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section {
    padding: 90px 2rem;
  }

  /* --- HERO --- */
  .merge-hero {
    position: relative;
    padding: 140px 2rem 110px;
    display: flex;
    justify-content: center;
    overflow: hidden;
    overflow: clip;
    background-color: var(--bg-dark);
    border-bottom: 4px solid var(--accent-pink);
  }

  .fiber-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mobile-gradient-bg {
    background: var(--bg-dark);
  }

  @media (max-width: 767px) {
    .mobile-gradient-bg::before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--purple-primary);
      opacity: 0;
      animation: pulseGradient 8s ease-in-out infinite alternate;
    }

    @keyframes pulseGradient {
      0% {
        opacity: 0;
      }
      100% {
        opacity: 0.8;
      }
    }
  }

  .dark-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 4, 26, 0.45);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 820px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(3.4rem, 11vw, 7.5rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -3px;
    color: #ffffff;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }

  .hero-title-accent {
    background: linear-gradient(90deg, var(--purple-neon), var(--accent-pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin-top: 0.75rem;
    font-size: clamp(1.2rem, 2.6vw, 1.75rem);
    font-weight: 600;
    color: var(--purple-neon);
  }

  .hero-text {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-actions .btn {
    gap: 0.5rem;
  }

  /* --- FAIXA DE INFOS --- */
  .infos-wrapper {
    position: relative;
    z-index: 5;
    max-width: 1200px;
    margin: -48px auto 0;
    padding: 0 2rem;
  }

  .infos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid var(--border-light);
    box-shadow: 0 12px 40px rgba(102, 44, 146, 0.12);
    overflow: hidden;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.3rem 1.4rem;
  }

  .info-item + .info-item {
    border-left: 1px solid var(--border-light);
  }

  .info-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--purple-primary), var(--purple-light));
    color: #ffffff;
    box-shadow: 0 6px 14px rgba(102, 44, 146, 0.3);
  }

  .info-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    color: var(--text-light);
  }

  .info-text strong {
    font-size: 0.98rem;
    color: #0d041a;
  }

  /* --- CABEÇALHOS --- */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tag {
    display: inline-block;
    padding: 6px 14px;
    background: rgba(122, 26, 143, 0.1);
    color: var(--purple-hero);
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    border: 1px solid rgba(122, 26, 143, 0.2);
  }

  .tag-dark {
    background: rgba(210, 168, 255, 0.1);
    color: var(--purple-neon);
    border-color: rgba(210, 168, 255, 0.25);
  }

  .section-header h2 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    color: #0d041a;
    margin-bottom: 1rem;
    font-weight: 700;
    letter-spacing: -1px;
  }

  .section-header.dark h2 {
    color: #ffffff;
  }

  .divider {
    width: 60px;
    height: 3px;
    background-color: var(--accent-pink);
    border-radius: 2px;
  }

  .section-lead {
    margin-top: 1.25rem;
    max-width: 680px;
    color: var(--text-light);
    line-height: 1.65;
    font-size: 1.02rem;
  }

  /* --- CADERNO --- */
  .caderno {
    padding-top: 80px;
    scroll-margin-top: 40px;
  }

  /* --- GUILDAS (CARDS DAS ORGANIZAÇÕES) --- */
  .guild-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    grid-auto-rows: 1fr;
    gap: 1.75rem;
  }

  .guild-grid-item {
    display: flex;
  }

  .guild-card {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: 24px;
    background: #ffffff;
    border: 1px solid var(--border-light);
    box-shadow: 0 8px 24px rgba(59, 0, 77, 0.07);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  /* Estandarte da guilda */
  .guild-banner {
    position: relative;
    width: 100%;
    height: 118px;
    flex-shrink: 0;
    background:
      radial-gradient(
        circle at 50% 120%,
        color-mix(in srgb, var(--org-cor) 35%, white) 0%,
        transparent 60%
      ),
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--org-cor) 85%, black) 0%,
        var(--org-cor) 55%,
        color-mix(in srgb, var(--org-cor) 70%, white) 100%
      );
  }

  .guild-banner-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.6) 0 2px,
        transparent 2px 18px
      ),
      repeating-linear-gradient(
        -45deg,
        rgba(255, 255, 255, 0.35) 0 2px,
        transparent 2px 18px
      );
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
  }

  .guild-exemplo {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    background: #fff4d6;
    color: #7a4b00;
    border: 1px solid #f5d27a;
  }

  /* Brasão (logo) sobreposto ao estandarte */
  .guild-emblem {
    position: relative;
    z-index: 1;
    margin-top: -78px;
    padding: 6px;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 14px 30px color-mix(in srgb, var(--org-cor) 30%, transparent);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .guild-body {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.1rem 1.5rem 1.6rem;
  }

  .guild-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0d041a;
    letter-spacing: -0.3px;
    line-height: 1.2;
  }

  .guild-nome {
    font-size: 0.84rem;
    color: var(--text-light);
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  .guild-divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 70%;
    margin: 1rem 0 0.9rem;
  }

  .guild-divider::before,
  .guild-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--org-cor) 55%, #d9cbe9)
    );
  }

  .guild-divider::after {
    transform: scaleX(-1);
  }

  .guild-divider span {
    width: 8px;
    height: 8px;
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--org-cor) 75%, #3b004d);
    border-radius: 2px;
  }

  .guild-resumo {
    flex-grow: 1;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #4a3a57;
  }

  .guild-papo {
    width: 100%;
    margin-top: 1.1rem;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    background: #f7f2ff;
    border: 1px dashed color-mix(in srgb, var(--org-cor) 45%, #d9cbe9);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .guild-papo-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--purple-hero);
  }

  .guild-papo-label :global(svg) {
    color: var(--accent-pink);
  }

  .guild-papo-text {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.45;
    color: #3b004d;
  }

  .guild-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.2rem;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--purple-primary);
    transition: gap 0.25s ease;
  }

  .guild-card--sem-pagina {
    cursor: default;
  }

  .guild-card-links {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    padding-top: 1.5rem;
  }

  .guild-card-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 12px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    background: #f7f2ff;
    color: var(--purple-primary);
    border: 1px solid var(--border-light);
    transition: all 0.2s ease;
  }

  .guild-card-link-btn:hover {
    background: var(--org-cor);
    color: #ffffff;
    border-color: var(--org-cor);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--org-cor) 35%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .guild-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--org-cor) 40%, white);
      box-shadow: 0 18px 38px color-mix(in srgb, var(--org-cor) 24%, transparent);
    }

    .guild-card:hover .guild-emblem {
      transform: translateY(-4px) scale(1.04);
    }

    .guild-card:hover .guild-cta {
      gap: 0.6rem;
    }
  }

  /* --- SOBRE / BENEFÍCIOS --- */
  .sobre {
    padding-top: 30px;
  }

  .beneficios {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .beneficio {
    padding: 1.75rem 1.5rem;
    border-radius: 18px;
    background: #ddd1ff;
  }

  .beneficio-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
