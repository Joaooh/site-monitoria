---
import Layout from "../layouts/Layout.astro";
import EditorApp from "../components/editor/EditorApp.jsx";
---

<Layout title="Editor Visual | Monitoria de TI - CEUB" hideNavbar={true}>
  <div class="editor-page">
    <EditorApp client:only="react" />
  </div>
</Layout>

<style>
  .editor-page {
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    background-color: var(--bg-dark);
    color: var(--text-main);
  }
</style>
