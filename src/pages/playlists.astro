---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/common/Footer.astro";
import { playlistsData } from "../data/playlists.js";
import { oficinasAtivasData } from "../data/oficinas-ativas.js";
import { oficinasPassadasData } from "../data/oficinas-passadas.js";
import { Image } from "astro:assets";
import magoWorking from "@assets/mago/mago-oficina-sem-fundo.png";
import magosTrabalhando from "@assets/mago/oficinas/magos-trabalhando.png";
import FiberBackground from "../components/effects/Fiber.jsx";

const todasOficinas = [...oficinasAtivasData, ...oficinasPassadasData];
const getImagemParaPlaylist = (slug: string) => {
  const oficina = todasOficinas.find((o) => o.linkInscricao.endsWith(slug));
  return oficina ? oficina.imagem : null;
};
---

<Layout
  title="Playlists | Monitoria de TI - CEUB"
  description="Assista às aulas gravadas das oficinas da Monitoria de TI do CEUB: Ciência de Dados, Machine Learning, SQL, Python, Modelagem 3D e mais."
>
  <main class="playlists-page">
    <section class="playlists-hero">
      <div class="fiber-container mobile-gradient-bg">
        <FiberBackground client:media="(min-width: 768px)" />
        <div class="dark-overlay"></div>
      </div>

      <div class="container">
        <div class="hero-content">
          <div class="text-column">
            <h2 class="pre-title">Nossas</h2>
            <h1 class="title">Aulas</h1>
            <p class="subtitle">
              Acesse e maratone as playlists das nossas oficinas, com acesso
              direto aos conteúdos gravados.
            </p>
          </div>

          <div class="image-column">
            <Image
              src={magoWorking}
              alt="Mago da monitoria trabalhando"
              class="mago-img"
              loading="eager"
              quality={70}
              format="webp"
              widths={[400, 800, 1280]}
              sizes="(max-width: 768px) 400px, (max-width: 1200px) 800px, 1280px"
            />
          </div>
        </div>
      </div>
    </section>

    <div class="theme-light-section" style="padding-top: 3rem;">
      <div class="netflix-container">
        {
          playlistsData.map((playlist) => {
            const fallbackImage = getImagemParaPlaylist(playlist.slug);

            if (!playlist.videos || playlist.videos.length === 0) return null;

            return (
              <section class="playlist-row">
                <div class="row-header">
                  <h2>{playlist.titulo}</h2>
                  <a
                    href={`/playlist/${playlist.slug}?from=playlists`}
                    class="ver-tudo"
                  >
                    Playlist completa
                  </a>
                </div>

                <div class="carousel-container">
                  <div class="carousel" style="align-items: stretch;">
                    {playlist.videos.map((vid: any, index: number) => {
                      const isYoutube = !!vid.id_youtube;
                      let thumbUrl = isYoutube
                        ? `https://img.youtube.com/vi/${vid.id_youtube}/hqdefault.jpg`
                        : null;

                      if (playlist.slug === "oficina-sql") {
                        thumbUrl = null;
                      }

                      if (
                        !isYoutube &&
                        (!vid.title ||
                          vid.title === "Em Breve" ||
                          vid.title.includes("Em Breve"))
                      ) {
                        return (
                          <div class="video-card empty-card">
                            <div class="thumbnail-wrapper placeholder-wrapper">
                              <Image
                                src={magosTrabalhando}
                                alt="Em Breve"
                                class="placeholder-bg"
                                width={640}
                              />
                              <div class="placeholder-thumb">Em Breve</div>
                            </div>
                            <div class="video-info">
                              <span class="ep-number">Aula {vid.numero || index + 1}</span>
                              <h3>Disponível em breve</h3>
                            </div>
                          </div>
                        );
                      }

                      return (
                        <a
                          href={`/playlist/${playlist.slug}?v=${index}&from=playlists`}
                          class="video-card"
                        >
                          <div class="thumbnail-wrapper">
                            {thumbUrl ? (
                              <Image
                                src={thumbUrl}
                                alt={vid.title}
                                class="thumbnail"
                                width={480}
                                height={360}
                                format="webp"
                                quality={80}
                              />
                            ) : fallbackImage ? (
                              <Image
                                src={fallbackImage}
                                alt={vid.title}
                                class="thumbnail fallback-thumb"
                                width={640}
                              />
                            ) : (
                              <div class="placeholder-thumb">Play</div>
                            )}
                            <div class="play-icon">
                              <svg
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                width="48"
                                height="48"
                              >
                                <path d="M8 5v14l11-7z" />
                              </svg>
                            </div>
                          </div>
                          <div class="video-info">
                            <span class="ep-number">Aula {vid.numero || index + 1}</span>
                            <h3>{vid.title}</h3>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
  <div class="theme-light-section">
    <Footer />
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const carousels = document.querySelectorAll(
        ".carousel",
      ) as NodeListOf<HTMLElement>;

      carousels.forEach((carousel) => {
        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        let isDragging = false;

        const checkScrollable = () => {
          return carousel.scrollWidth > carousel.clientWidth;
        };

        const updateCursor = () => {
          carousel.style.cursor = checkScrollable() ? "grab" : "default";
        };

        updateCursor();
        window.addEventListener("resize", updateCursor);

        carousel.addEventListener("mousedown", (e) => {
          if (window.innerWidth < 768) return;
          if (!checkScrollable()) return;
          isDown = true;
          isDragging = false;
          carousel.style.cursor = "grabbing";
          carousel.style.scrollSnapType = "none";
          carousel.style.userSelect = "none";
          startX = e.pageX - carousel.offsetLeft;
          scrollLeft = carousel.scrollLeft;
        });

        carousel.addEventListener("mouseleave", () => {
          if (!isDown) return;
          isDown = false;
          carousel.style.cursor = checkScrollable() ? "grab" : "default";
          carousel.style.scrollSnapType = "x mandatory";
          carousel.style.userSelect = "auto";
        });

        carousel.addEventListener("mouseup", () => {
          isDown = false;
          carousel.style.cursor = checkScrollable() ? "grab" : "default";
          carousel.style.scrollSnapType = "x mandatory";
          carousel.style.userSelect = "auto";
        });

        carousel.addEventListener("mousemove", (e) => {
          if (window.innerWidth < 768) return;

          if (!isDown) return;
          e.preventDefault();
          isDragging = true;
          const x = e.pageX - carousel.offsetLeft;
          const walk = (x - startX) * 4;
          carousel.scrollLeft = scrollLeft - walk;
        });

        carousel.addEventListener("dragstart", (e) => {
          e.preventDefault();
        });

        const links = carousel.querySelectorAll("a");
        links.forEach((link) => {
          link.addEventListener("click", (e) => {
            if (isDragging) {
              e.preventDefault();
              e.stopPropagation();
            }
          });
        });
      });
    });
  </script>
</Layout>

<style>
  .playlists-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #fdfdfd;
  }

  .theme-light-section {
    background-color: #fdfdfd !important;
    color: #1a1a24 !important;
    flex-grow: 1;
  }

  .playlists-hero {
    position: relative;
    padding: 90px 2rem 0 2rem;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
    background-color: var(--bg-dark, #0d041a);
    min-height: 40vh;
    border-bottom: 4px solid var(--purple-hero);
    margin-bottom: 0;
  }

  .fiber-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .mobile-gradient-bg {
    background: var(--bg-dark);
  }

  .mobile-gradient-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--purple-primary);
    opacity: 0;
    transition: opacity 5s ease-in-out;
    animation: pulseGradient 8s ease-in-out infinite alternate;
  }

  @keyframes pulseGradient {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 0.8;
    }
  }

  .dark-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 4, 26, 0.4);
  }

  .hero-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    margin-top: 2rem;
    position: relative;
    z-index: 2;
  }

  .text-column {
    flex: 0 0 45%;
    padding-bottom: 50px;
  }

  .pre-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 400;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: -0.5px;
    line-height: 1;
    text-transform: none;
  }

  .title {
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: #ffffff;
    letter-spacing: -2px;
    line-height: 1;
    margin-left: -4px;
    text-shadow: none;
  }

  .subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin: 0;
    max-width: 600px;
  }

  .image-column {
    flex-shrink: 0;
    width: 50%;
    max-width: 600px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .mago-img {
    width: 100%;
    height: auto;
    max-width: 550px;
    object-fit: contain;
    transform-origin: bottom center;
    transform: scaleX(-1);
    filter: drop-shadow(0 -5px 25px rgba(0, 0, 0, 0.4));
  }

  /* --- RESPONSIVIDADE MOBILE --- */
  @media (max-width: 992px) {
    .hero-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-top: 40px;
    }

    .text-column {
      flex: 1;
      padding-bottom: 20px;
      padding-top: 0;
      align-items: center;
    }

    .title {
      margin-left: 0;
    }

    .image-column {
      width: 80%;
      flex: 1;
      justify-content: center;
      margin-bottom: -2px;
    }

    .mago-img {
      max-width: 350px;
      width: 100%;
      height: auto;
      object-fit: contain;
      object-position: center bottom;
      transform: scaleX(-1);
    }

    .playlists-hero {
      padding: 46px 2rem 0 2rem;
    }
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    height: 100%;
  }

  .netflix-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .playlist-row {
    position: relative;
  }

  .row-header {
    padding: 0 4%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.2rem;
  }

  .row-header h2 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    color: #0d041a;
  }

  .ver-tudo {
    font-size: 0.9rem;
    color: #662c92;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .ver-tudo:hover {
    color: #481d69;
  }

  .carousel-container {
    position: relative;
  }

  .carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 10px 4% 30px 4%;
    scroll-padding-inline-start: 4%;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x mandatory;
    align-items: stretch;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .video-card {
    flex: 0 0 calc(100% / 4 - 16px);
    min-width: 280px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    scroll-snap-align: start;
    height: auto;
  }

  .empty-card {
    pointer-events: none;
  }

  .video-card:hover {
    transform: scale(1.04);
    z-index: 2;
  }

  .thumbnail-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  .placeholder-wrapper {
    position: relative;
    background: #1a1a1a;
    border: 1px dashed rgba(0, 0, 0, 0.2);
  }

  .placeholder-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.15;
    z-index: 0;
  }

  .thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .fallback-thumb {
    object-fit: cover;
    background: #160824;
    opacity: 0.9;
  }

  .placeholder-thumb {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 1;
  }

  .play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    color: white;
  }

  .video-card:hover .play-icon {
    opacity: 1;
  }

  .video-info {
    margin-top: 1rem;
    padding: 0 4px;
  }

  .ep-number {
    font-size: 0.8rem;
    color: #662c92;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .video-info h3 {
    font-size: 1.05rem;
    color: #1a1a24;
    margin-top: 6px;
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-card .video-info h3 {
    color: #444;
  }

  @media (max-width: 1200px) {
    .video-card {
      flex: 0 0 calc(100% / 3 - 16px);
    }
  }

  @media (max-width: 800px) {
    .video-card {
      flex: 0 0 calc(100% / 2 - 16px);
      min-width: 240px;
    }
  }

  @media (max-width: 500px) {
    .video-card {
      flex: 0 0 85%;
      min-width: 260px;
    }
    .row-header h2 {
      font-size: 1.2rem;
    }
  }
</style>
